      "fields": [
        {
          "comment": {
            "description": "The type of component affected by the vulnerability, based on the NIST CPE 2.3 taxonomy. Corresponds to the CPE part attribute values: a (application), h (hardware), o (operating system).",
            "expected_values": [
              "application",
              "hardware",
              "operating system"
            ]
          },
          "fieldName": "affected_component_type",
          "displayName": "affected_component_type",
          "type": "string",
          "fieldSearch": "",
          "required": false,
          "multivalue": false,
          "hidden": false
        },
        {
          "comment": {
            "description": "The name of the product affected by the vulnerability. Distinct from vendor_product, which identifies the scanning or reporting tool (e.g., AWS Inspector, Tenable Nessus). Use this field to capture the software or system that contains the CVE, not the tool that detected it."
          },
          "fieldName": "affected_product",
          "displayName": "affected_product",
          "type": "string",
          "fieldSearch": "",
          "required": false,
          "multivalue": true,
          "hidden": false
        },
        {
          "comment": {
            "description": "The specific version of the affected product (e.g., 1.0.0, 2.3.1). Provides granularity for scoping vulnerability impact to a specific release."
          },
          "fieldName": "affected_product_version",
          "displayName": "affected_product_version",
          "type": "string",
          "fieldSearch": "",
          "required": false,
          "multivalue": true,
          "hidden": false
        },
        {

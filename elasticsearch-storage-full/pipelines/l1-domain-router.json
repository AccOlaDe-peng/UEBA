{
  "description": "Route one normalized event to exactly one semantic L1 data stream",
  "version": 10000,
  "processors": [
    {
      "reroute": {
        "if": "ctx.ueba?.quality?.status == 'invalid' || ctx.ueba?.quality?.status == 'unsupported' || ctx.event?.kind == 'pipeline_error'",
        "destination": {
          "type": "logs",
          "dataset": "ueba.quarantine",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.kind == 'metric'",
        "destination": {
          "type": "logs",
          "dataset": "ueba.metric",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.kind == 'state'",
        "destination": {
          "type": "logs",
          "dataset": "ueba.state",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.kind == 'alert' || (ctx.event?.category != null && ctx.event.category.contains('intrusion_detection'))",
        "destination": {
          "type": "logs",
          "dataset": "ueba.alert",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.dataset != null && (ctx.event.dataset.endsWith('.dns') || ctx.event.dataset == 'zeek.dns')",
        "destination": {
          "type": "logs",
          "dataset": "ueba.dns",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.category != null && ctx.event.category.contains('web')",
        "destination": {
          "type": "logs",
          "dataset": "ueba.web",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.dataset != null && (ctx.event.dataset.endsWith('.ssl') || ctx.event.dataset.endsWith('.x509') || ctx.event.dataset.endsWith('.ocsp'))",
        "destination": {
          "type": "logs",
          "dataset": "ueba.tls",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.category != null && ctx.event.category.contains('authentication')",
        "destination": {
          "type": "logs",
          "dataset": "ueba.authentication",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.ueba?.event?.type != null && ctx.ueba.event.type.startsWith('directory.')",
        "destination": {
          "type": "logs",
          "dataset": "ueba.directory",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.category != null && ctx.event.category.contains('iam')",
        "destination": {
          "type": "logs",
          "dataset": "ueba.iam",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.category != null && (ctx.event.category.contains('process') || ctx.event.category.contains('package') || ctx.event.category.contains('configuration') || ctx.event.category.contains('host'))",
        "destination": {
          "type": "logs",
          "dataset": "ueba.endpoint",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.category != null && ctx.event.category.contains('email')",
        "destination": {
          "type": "logs",
          "dataset": "ueba.email",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.category != null && ctx.event.category.contains('file')",
        "destination": {
          "type": "logs",
          "dataset": "ueba.file",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.category != null && ctx.event.category.contains('session')",
        "destination": {
          "type": "logs",
          "dataset": "ueba.session",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    {
      "reroute": {
        "if": "ctx.event?.category != null && ctx.event.category.contains('network')",
        "destination": {
          "type": "logs",
          "dataset": "ueba.network",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    },
    { "set": { "field": "ueba.quality.status", "value": "unsupported" } },
    {
      "append": {
        "field": "ueba.quality.errors",
        "value": "unroutable_event_semantics",
        "allow_duplicates": false
      }
    },
    {
      "reroute": {
        "destination": {
          "type": "logs",
          "dataset": "ueba.quarantine",
          "namespace": "{{{data_stream.namespace}}}"
        }
      }
    }
  ]
}

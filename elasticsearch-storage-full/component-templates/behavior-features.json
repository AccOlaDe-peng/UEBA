{
  "template": {
    "settings": {
      "index.mapping.total_fields.limit": 500
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "organization": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "entity": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "peer_group_ids": {
              "type": "keyword"
            }
          }
        },
        "feature": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            },
            "value": {
              "type": "double"
            },
            "value_keyword": {
              "type": "keyword"
            },
            "values": {
              "type": "double"
            },
            "unit": {
              "type": "keyword"
            },
            "sample_count": {
              "type": "long"
            },
            "dimensions": {
              "type": "flattened"
            }
          }
        },
        "window": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "start": {
              "type": "date"
            },
            "end": {
              "type": "date"
            },
            "duration_ms": {
              "type": "long"
            }
          }
        },
        "inputs": {
          "properties": {
            "event_ids": {
              "type": "keyword"
            },
            "event_count": {
              "type": "long"
            },
            "datasets": {
              "type": "keyword"
            },
            "mapping_versions": {
              "type": "keyword"
            },
            "resolution_version": {
              "type": "keyword"
            }
          }
        },
        "quality": {
          "properties": {
            "status": {
              "type": "keyword"
            },
            "score": {
              "type": "scaled_float",
              "scaling_factor": 1000
            },
            "warnings": {
              "type": "keyword"
            }
          }
        }
      }
    }
  },
  "version": 10000,
  "_meta": {
    "artifact": "ueba-behavior-features",
    "semantic_version": "1.0.0"
  }
}

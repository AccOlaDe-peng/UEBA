{
  "template": {
    "settings": {
      "index.mapping.total_fields.limit": 200
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "organization": {
          "properties": {
            "id": {
              "type": "keyword"
            }
          }
        },
        "event": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "created": {
              "type": "date"
            },
            "original": {
              "type": "keyword",
              "index": false,
              "doc_values": false
            }
          }
        },
        "data_stream": {
          "properties": {
            "type": {
              "type": "constant_keyword",
              "value": "logs"
            },
            "dataset": {
              "type": "constant_keyword",
              "value": "ueba.raw"
            },
            "namespace": {
              "type": "constant_keyword"
            }
          }
        },
        "ueba": {
          "properties": {
            "source": {
              "properties": {
                "type": {
                  "type": "keyword"
                },
                "namespace": {
                  "type": "keyword"
                },
                "native_event_id": {
                  "type": "keyword"
                },
                "collected_at": {
                  "type": "date"
                },
                "received_at": {
                  "type": "date"
                }
              }
            },
            "provenance": {
              "properties": {
                "raw_event_id": {
                  "type": "keyword"
                },
                "raw_uri": {
                  "type": "keyword",
                  "index": false
                },
                "raw_sha256": {
                  "type": "keyword"
                }
              }
            }
          }
        },
        "agent": {
          "properties": {
            "id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "type": {
              "type": "keyword"
            },
            "version": {
              "type": "keyword"
            }
          }
        },
        "log": {
          "properties": {
            "file": {
              "properties": {
                "path": {
                  "type": "keyword"
                }
              }
            },
            "offset": {
              "type": "long"
            }
          }
        },
        "labels": {
          "type": "flattened"
        },
        "error": {
          "properties": {
            "message": {
              "type": "match_only_text"
            }
          }
        }
      }
    }
  },
  "version": 10000,
  "_meta": {
    "artifact": "ueba-raw-evidence",
    "semantic_version": "1.0.0"
  }
}

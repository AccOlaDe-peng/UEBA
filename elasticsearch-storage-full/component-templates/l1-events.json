{
  "template": {
    "settings": {
      "index.mapping.total_fields.limit": 2500,
      "index.mapping.depth.limit": 20,
      "index.mapping.nested_fields.limit": 20,
      "index.default_pipeline": "ueba-l1-common-validate-1.0.0"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": { "type": "date" },
        "ecs": { "properties": { "version": { "type": "keyword" } } },
        "data_stream": {
          "properties": {
            "type": { "type": "constant_keyword", "value": "logs" },
            "dataset": { "type": "constant_keyword" },
            "namespace": { "type": "constant_keyword" }
          }
        },
        "organization": {
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" }
          }
        },
        "agent": {
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" },
            "type": { "type": "keyword" },
            "version": { "type": "keyword" }
          }
        },
        "event": {
          "properties": {
            "id": { "type": "keyword" },
            "kind": { "type": "keyword" },
            "category": { "type": "keyword" },
            "type": { "type": "keyword" },
            "action": { "type": "keyword" },
            "outcome": { "type": "keyword" },
            "code": { "type": "keyword" },
            "module": { "type": "keyword" },
            "dataset": { "type": "keyword" },
            "provider": { "type": "keyword" },
            "reason": { "type": "keyword", "ignore_above": 2048 },
            "created": { "type": "date" },
            "ingested": { "type": "date" },
            "start": { "type": "date" },
            "end": { "type": "date" },
            "duration": { "type": "long" },
            "original": {
              "type": "keyword",
              "index": false,
              "doc_values": false
            }
          }
        },
        "error": {
          "properties": {
            "message": { "type": "match_only_text" },
            "type": { "type": "keyword" }
          }
        },
        "message": { "type": "match_only_text" },
        "tags": { "type": "keyword" },
        "labels": { "type": "flattened" },
        "log": {
          "properties": {
            "level": { "type": "keyword" },
            "file": { "properties": { "path": { "type": "keyword" } } },
            "offset": { "type": "long" }
          }
        },
        "user": {
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" },
            "domain": { "type": "keyword" },
            "full_name": { "type": "keyword" },
            "email": { "type": "keyword" },
            "roles": { "type": "keyword" },
            "target": {
              "properties": {
                "id": { "type": "keyword" },
                "name": { "type": "keyword" },
                "domain": { "type": "keyword" }
              }
            },
            "effective": {
              "properties": {
                "id": { "type": "keyword" },
                "name": { "type": "keyword" },
                "domain": { "type": "keyword" }
              }
            }
          }
        },
        "group": {
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" }
          }
        },
        "host": {
          "dynamic": false,
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" },
            "hostname": { "type": "keyword" },
            "domain": { "type": "keyword" },
            "ip": { "type": "ip" },
            "mac": { "type": "keyword" },
            "architecture": { "type": "keyword" }
          }
        },
        "observer": {
          "dynamic": false,
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" },
            "hostname": { "type": "keyword" },
            "ip": { "type": "ip" },
            "type": { "type": "keyword" },
            "vendor": { "type": "keyword" },
            "product": { "type": "keyword" }
          }
        },
        "source": {
          "dynamic": false,
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "long" },
            "mac": { "type": "keyword" },
            "address": { "type": "keyword" },
            "domain": { "type": "keyword" },
            "bytes": { "type": "long" },
            "packets": { "type": "long" }
          }
        },
        "destination": {
          "dynamic": false,
          "properties": {
            "ip": { "type": "ip" },
            "port": { "type": "long" },
            "mac": { "type": "keyword" },
            "address": { "type": "keyword" },
            "domain": { "type": "keyword" },
            "bytes": { "type": "long" },
            "packets": { "type": "long" }
          }
        },
        "client": { "type": "object", "dynamic": false },
        "server": { "type": "object", "dynamic": false },
        "network": {
          "properties": {
            "transport": { "type": "keyword" },
            "protocol": { "type": "keyword" },
            "direction": { "type": "keyword" },
            "community_id": { "type": "keyword" },
            "bytes": { "type": "long" },
            "packets": { "type": "long" }
          }
        },
        "process": {
          "dynamic": false,
          "properties": {
            "pid": { "type": "long" },
            "name": { "type": "keyword" },
            "executable": { "type": "keyword" },
            "command_line": { "type": "wildcard" },
            "args": { "type": "keyword" },
            "args_count": { "type": "long" },
            "working_directory": { "type": "keyword" },
            "exit_code": { "type": "long" },
            "parent": {
              "properties": {
                "pid": { "type": "long" },
                "name": { "type": "keyword" },
                "executable": { "type": "keyword" }
              }
            }
          }
        },
        "service": {
          "dynamic": false,
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" },
            "type": { "type": "keyword" }
          }
        },
        "package": {
          "properties": {
            "name": { "type": "keyword" },
            "version": { "type": "keyword" }
          }
        },
        "file": {
          "dynamic": false,
          "properties": {
            "name": { "type": "keyword" },
            "path": { "type": "keyword" },
            "size": { "type": "long" },
            "mime_type": { "type": "keyword" },
            "hash": {
              "properties": {
                "md5": { "type": "keyword" },
                "sha1": { "type": "keyword" },
                "sha256": { "type": "keyword" }
              }
            }
          }
        },
        "url": {
          "properties": {
            "original": { "type": "wildcard" },
            "full": { "type": "wildcard" },
            "domain": { "type": "keyword" },
            "path": { "type": "wildcard" },
            "query": { "type": "wildcard" }
          }
        },
        "http": {
          "dynamic": false,
          "properties": {
            "version": { "type": "keyword" },
            "request": {
              "properties": {
                "method": { "type": "keyword" },
                "body": { "properties": { "bytes": { "type": "long" } } }
              }
            },
            "response": {
              "properties": {
                "status_code": { "type": "long" },
                "body": { "properties": { "bytes": { "type": "long" } } }
              }
            }
          }
        },
        "dns": {
          "dynamic": false,
          "properties": {
            "id": { "type": "keyword" },
            "response_code": { "type": "keyword" },
            "resolved_ip": { "type": "ip" },
            "question": {
              "properties": {
                "name": { "type": "keyword" },
                "type": { "type": "keyword" },
                "class": { "type": "keyword" }
              }
            }
          }
        },
        "tls": {
          "dynamic": false,
          "properties": {
            "version": { "type": "keyword" },
            "version_protocol": { "type": "keyword" },
            "cipher": { "type": "keyword" },
            "established": { "type": "boolean" }
          }
        },
        "email": {
          "dynamic": false,
          "properties": {
            "message_id": { "type": "keyword" },
            "from": { "properties": { "address": { "type": "keyword" } } },
            "to": { "properties": { "address": { "type": "keyword" } } },
            "cc": { "properties": { "address": { "type": "keyword" } } }
          }
        },
        "user_agent": { "properties": { "original": { "type": "wildcard" } } },
        "rule": {
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword" }
          }
        },
        "related": {
          "properties": {
            "ip": { "type": "ip" },
            "user": { "type": "keyword" },
            "hosts": { "type": "keyword" },
            "hash": { "type": "keyword" }
          }
        },
        "ueba": {
          "properties": {
            "schema": { "properties": { "version": { "type": "keyword" } } },
            "source": {
              "properties": {
                "type": { "type": "keyword" },
                "namespace": { "type": "keyword" },
                "native_event_id": { "type": "keyword" },
                "collected_at": { "type": "date" },
                "received_at": { "type": "date" }
              }
            },
            "event": {
              "properties": {
                "type": { "type": "keyword" },
                "semantic_tags": { "type": "keyword" }
              }
            },
            "session": {
              "properties": {
                "id": { "type": "keyword" },
                "type": { "type": "keyword" },
                "assigned_ip": { "type": "ip" }
              }
            },
            "time": {
              "properties": {
                "source": { "type": "keyword" },
                "quality": { "type": "keyword" },
                "original": { "type": "keyword" },
                "original_timezone": { "type": "keyword" }
              }
            },
            "provenance": {
              "properties": {
                "raw_event_id": { "type": "keyword" },
                "raw_uri": { "type": "keyword", "index": false },
                "raw_sha256": { "type": "keyword" },
                "parser_id": { "type": "keyword" },
                "parser_version": { "type": "keyword" },
                "mapping_id": { "type": "keyword" },
                "mapping_version": { "type": "keyword" }
              }
            },
            "quality": {
              "properties": {
                "status": { "type": "keyword" },
                "score": { "type": "scaled_float", "scaling_factor": 1000 },
                "errors": { "type": "keyword" },
                "warnings": { "type": "keyword" }
              }
            }
          }
        },
        "winlog": {
          "properties": {
            "record_id": { "type": "keyword" },
            "channel": { "type": "keyword" },
            "version": { "type": "long" },
            "event_data": { "type": "flattened" },
            "fields": { "type": "flattened" }
          }
        },
        "zeek": {
          "properties": {
            "session_id": { "type": "keyword" },
            "file_id": { "type": "keyword" },
            "fields": { "type": "flattened" }
          }
        },
        "linux": {
          "properties": {
            "record_type": { "type": "keyword" },
            "audit_id": { "type": "keyword" },
            "operation": { "type": "keyword" },
            "fields": { "type": "flattened" }
          }
        },
        "auditd": {
          "properties": {
            "sequence": { "type": "long" },
            "session": { "type": "keyword" },
            "fields": { "type": "flattened" }
          }
        },
        "vendor": {
          "properties": {
            "name": { "type": "keyword" },
            "product": { "type": "keyword" },
            "dataset": { "type": "keyword" },
            "schema_version": { "type": "keyword" },
            "payload": { "type": "flattened" }
          }
        }
      }
    }
  },
  "version": 10000,
  "_meta": {
    "artifact": "ueba-l1-events",
    "semantic_version": "1.0.0",
    "field_contract": "UEBA日志分类与最小ECS字段全量表"
  }
}

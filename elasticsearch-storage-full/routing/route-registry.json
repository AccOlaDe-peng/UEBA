    "authentication",
    "iam",
    "directory",
    "endpoint",
    "network",
    "dns",
    "web",
    "tls",
    "file",
    "session",
    "email",
    "alert",
    "state",
    "metric"
  ],
  "windows_security_event_code": {
    "4624": "authentication",
    "4625": "authentication",
    "4634": "session",
    "4647": "session",
    "4648": "authentication",
    "4661": "directory",
    "4662": "directory",
    "4670": "directory",
    "4673": "directory",
    "4688": "endpoint",
    "4689": "endpoint",
    "4720": "iam",
    "4722": "iam",
    "4723": "iam",
    "4724": "iam",
    "4725": "iam",
